# Copy this file to `.env` and fill in real values. `.env` is gitignored and must never be committed.

# LLM backend for the v3 experiment suite (OpenAI-compatible).
# The base URL must be an OpenAI-compatible /chat/completions endpoint root (with or without trailing /v1).
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_API_KEY=your_api_key_here
AGNES_MODEL=agnes-2.5-flash

# Backend server config (optional overrides; defaults come from digital-twingo/scene-server-go/application.yml)
LLM_TIMEOUT_SECONDS=180
LLM_MAX_TOOL_ROUNDS=2
