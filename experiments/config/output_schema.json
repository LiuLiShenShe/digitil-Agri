          },
          "name": {
            "type": "string"
          },
          "parentId": {
            "type": "string"
          },
          "area": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          }
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "subject",
          "predicate",
          "object"
        ],
        "properties": {
          "subject": {
            "type": "string"
          },
          "predicate": {
            "type": "string"
          },
          "object": {
            "type": "string"
          }
        }
      }
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "subject",
          "target",
          "type"
        ],
        "properties": {
          "subject": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          }
        }
      }
    },
    "checkedRules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "violatedRules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "traceSteps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "traceType",
          "agent",
          "tool",
          "inputSummary",
          "outputSummary",
          "status"
