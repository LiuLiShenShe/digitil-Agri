          "agent": {
            "type": "string"
          },
          "tool": {
            "type": "string"
          },
          "inputSummary": {
            "type": "string"
          },
          "outputSummary": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "evidenceId": {
            "type": "string"
          },
          "callId": {
            "type": "string"
          }
        }
      }
    },
    "toolEvidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "evidenceId": {
            "type": "string"
          },
          "tool": {
            "type": "string"
          },
          "traceType": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          }
        }
      }
    },
